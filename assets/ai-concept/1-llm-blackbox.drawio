<mxfile host="Electron">
  <diagram id="d1" name="LLM黑箱模型">
    <mxGraphModel dx="808" dy="475" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="200" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="in_frame" parent="1" style="swimlane;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;startSize=24;rounded=1;arcSize=8;fillColor=#f8f9fa;strokeColor=#333333;strokeWidth=1.5;" value="输入" vertex="1">
          <mxGeometry height="110" width="180" x="30" y="40" as="geometry" />
        </mxCell>
        <mxCell id="in_node" parent="in_frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;fontSize=12;" value="用户输入&lt;br&gt;(Prompt / 提问)" vertex="1">
          <mxGeometry height="55" width="150" x="15" y="35" as="geometry" />
        </mxCell>
        <mxCell id="blackbox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a1a;strokeColor=#000000;strokeWidth=2;fontSize=13;fontColor=#ffffff;arcSize=10;" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;大模型（LLM）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ffffff&quot;&gt;【 概率黑箱 】&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#cccccc&quot;&gt;（基于统计概率猜词）&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="190" x="275" y="45" as="geometry" />
        </mxCell>
        <mxCell id="out_frame" parent="1" style="swimlane;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;startSize=24;rounded=1;arcSize=8;fillColor=#f8f9fa;strokeColor=#333333;strokeWidth=1.5;" value="输出" vertex="1">
          <mxGeometry height="110" width="200" x="530" y="40" as="geometry" />
        </mxCell>
        <mxCell id="out_node" parent="out_frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#28a745;strokeColor=#1e7e34;strokeWidth=1;fontSize=12;fontColor=#ffffff;" value="&lt;b&gt;大概率正确的内容&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ffffff&quot; style=&quot;font-size: 11px;&quot;&gt;(单次预测回复结果)&lt;/font&gt;" vertex="1">
          <mxGeometry height="55" width="170" x="15" y="35" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="in_frame" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=1.5;strokeColor=#000000;fontSize=11;" target="blackbox" value="输入黑箱">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="blackbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=1.5;strokeColor=#000000;fontSize=11;" target="out_frame" value="概率推演">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
