{
  "headers": [
    {
      "source": "/(css|js|images|assets|fonts|libs)/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/posts/:id/",
      "destination": "/posts/:id",
      "statusCode": 301
    },
    {
      "source": "/tags/:name/",
      "destination": "/tags/:name",
      "statusCode": 301
    },
    {
      "source": "/categories/:name/",
      "destination": "/categories/:name",
      "statusCode": 301
    }
  ]
}
